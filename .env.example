# 调用本服务的认证令牌。请替换为随机生成的长令牌。
authToken=xxxxxxxxxxxxxxxxxxxxx

# 使用该令牌时，data 直接返回未加密的扁平 JSON。必须与 authToken 不同。
noencrypt_authToken=xxxxxxxxxxxxxxxxxxxxx

# AES-256-GCM 密钥材料。服务会先使用 SHA-256 派生 256 位密钥。
encryptToken=xxxxxxxxxxx

# 飞书自建应用凭据。
APP_ID=cli_xxxxxxxxxxxxx
APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选配置。
BIND_ADDR=0.0.0.0:8080
OPENLARK_BASE_URL=https://open.feishu.cn
RUST_LOG=openlark_bitable_service=info,salvo=info
